{
  "name": "omnipos-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "OmniPOS developer console and licensed Windows point of sale",
  "author": "Charles Manalo",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/pos/main.cjs",
  "scripts": {
    "dev:pos": "node scripts/dev.mjs pos",
    "dev:developer": "node scripts/dev.mjs developer",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "postinstall": "node scripts/verify-native.mjs",
    "native:verify": "node scripts/verify-native.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package:pos": "node scripts/package.mjs pos",
    "package:developer": "node scripts/package.mjs developer",
    "package": "npm run build && npm run package:pos && npm run package:developer",
    "test:desktop": "node scripts/smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:hosted": "node scripts/hosted-smoke.mjs --live",
    "test:integration": "node scripts/integration.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "format": "prettier --write apps packages scripts tests docs README.md *.json *.ts .github/workflows/*.yml",
    "keys:generate": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "prettier": "3.9.9",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
